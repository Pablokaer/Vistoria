# Copy to .env and adjust. NEVER commit real credentials.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development   # Development enables demo seed data + OpenAPI; use Production for real deployments

# --- Database ---
POSTGRES_DB=inspectflow
POSTGRES_USER=inspectflow
POSTGRES_PASSWORD=change-me
# Used by the API outside docker compose (compose builds it from the values above):
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=inspectflow;Username=inspectflow;Password=change-me

# --- Security (generate with: openssl rand -base64 48) ---
JWT_SECRET=replace-with-at-least-32-random-characters
STORAGE_SIGNING_KEY=replace-with-at-least-32-random-characters

# --- Storage ---
STORAGE_PROVIDER=Local            # Local (development). S3 / AzureBlob plug in behind IStorageService.
STORAGE_LOCAL_PATH=data/storage   # relative to the API content root, or absolute

# --- AI ---
AI_PROVIDER=Auto                  # Auto = OpenAI when OPENAI_API_KEY is set, otherwise the labelled mock (Development only)
OPENAI_API_KEY=                   # server-side only; never exposed to the browser or logs
OPENAI_MODEL=gpt-4.1-mini

# --- Billing (no free plan: Company accounts need an active subscription) ---
BILLING_PROVIDER=Auto             # Auto = Stripe when STRIPE_SECRET_KEY is set, otherwise the Sandbox (Development only)
STRIPE_SECRET_KEY=                # server-side only (sk_live_... / sk_test_...)
STRIPE_WEBHOOK_SECRET=            # whsec_... of the endpoint https://<api>/api/billing/webhooks/Stripe
STRIPE_PRICE_ID=                  # price_... of the "professional" plan (Billing:Plans:0)

# --- URLs ---
WEB_BASE_URL=http://localhost:3000   # used in invitation / share links
MIGRATE_ON_STARTUP=true
SEED_DEMO_DATA=true                  # ignored outside Development
TRUST_FORWARDED_HEADERS=false        # true only when the API is reachable exclusively through a trusted reverse proxy
