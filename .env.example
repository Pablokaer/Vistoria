# Copy to .env and adjust. NEVER commit real credentials.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development   # Development enables demo seed data + OpenAPI; use Production for real deployments

# --- Database ---
POSTGRES_DB=inspectflow
POSTGRES_USER=inspectflow
POSTGRES_PASSWORD=change-me
# Used by the API outside docker compose (compose builds it from the values above):
DATABASE_CONNECTION_STRING=Host=localhost;Port=15432;Database=inspectflow;Username=inspectflow;Password=change-me

# --- Security (generate with: openssl rand -base64 48) ---
JWT_SECRET=replace-with-at-least-32-random-characters
STORAGE_SIGNING_KEY=replace-with-at-least-32-random-characters

# --- Storage ---
STORAGE_PROVIDER=Local            # Local (development). S3 / AzureBlob plug in behind IStorageService.
STORAGE_LOCAL_PATH=data/storage   # relative to the API content root, or absolute

# --- AI ---
AI_PROVIDER=Auto                  # Auto = OpenAI when OPENAI_API_KEY is set, otherwise the labelled mock (Development only)
# Server-side only; never exposed to the browser or logs. Comments on empty values go on their own line:
# compose reads "VAR=   # text" as the value "# text".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Billing (no free plan: Company accounts need an active subscription) ---
BILLING_PROVIDER=Auto             # Auto = Stripe when STRIPE_SECRET_KEY is set, otherwise the Sandbox (Development only)
# Server-side only: STRIPE_SECRET_KEY (sk_live_... / sk_test_...), STRIPE_WEBHOOK_SECRET (whsec_... of the endpoint
# https://<api>/api/billing/webhooks/Stripe), STRIPE_PRICE_ID (price_... of the "professional" plan, Billing:Plans:0).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- URLs ---
WEB_BASE_URL=http://localhost:3000   # used in invitation / share links
MIGRATE_ON_STARTUP=true
SEED_DEMO_DATA=true                  # ignored outside Development
TRUST_FORWARDED_HEADERS=false        # true only when the API is reachable exclusively through a trusted reverse proxy
# Required with TRUST_FORWARDED_HEADERS=true: that proxy's IPs/CIDRs, comma-separated (never the web container).
# (Comment on its own line: compose reads "VAR=   # text" as the value "# text".)
TRUSTED_PROXIES=

# --- Published ports (docker compose; always on 127.0.0.1 except the web app when opened to the LAN) ---
WEB_BIND_ADDRESS=127.0.0.1           # 0.0.0.0 makes http://<this machine's LAN IP>:3000 reachable, e.g. from a phone
# WEB_PORT=3000  API_PORT=8080  POSTGRES_PORT=15432 (not 5432: a local PostgreSQL install usually holds it)

# Production uses docker-compose.prod.yml with .env.production (see .env.production.example), not this file.
