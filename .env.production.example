# Production settings for docker-compose.prod.yml. Copy to .env.production (gitignored) and fill in every value:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up --build -d
# NEVER commit the filled-in file. Generate secrets with: openssl rand -base64 48

# --- Public address ---
SITE_ADDRESS=app.example.com          # Caddy site: a domain gets automatic HTTPS (ports 80 + 443 open); ":80" behind another TLS terminator
WEB_BASE_URL=https://app.example.com  # used in invitation / share / checkout links
HTTP_PORT=80
HTTPS_PORT=443

# --- Database (not published on the host) ---
POSTGRES_DB=inspectflow
POSTGRES_USER=inspectflow
POSTGRES_PASSWORD=

# --- Security (at least 32 random characters each; "dev-only-*" values are refused) ---
JWT_SECRET=
STORAGE_SIGNING_KEY=

# --- AI ---
AI_PROVIDER=Auto                      # Auto = OpenAI when OPENAI_API_KEY is set; without a key AI requests fail with a clear message
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Billing (companies need a subscription; without Stripe, checkout fails with a clear message) ---
BILLING_PROVIDER=Auto
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: whsec_... of https://<SITE_ADDRESS>/api/billing/webhooks/Stripe. Comments on empty values
# go on their own line: compose reads "VAR=   # text" as the value "# text".
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Start-up ---
MIGRATE_ON_STARTUP=true               # false if you apply a reviewed migration script yourself (README → Database migrations)

# --- Internal network (change both only if 172.30.250.0/24 clashes with a network on the host) ---
INTERNAL_SUBNET=172.30.250.0/24
CADDY_IP=172.30.250.10                # the only address the API accepts X-Forwarded-For from
