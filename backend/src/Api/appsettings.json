{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "inspectflow",
    "Audience": "inspectflow-clients",
    "Secret": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "Provider": "Local",
    "SigningKey": "",
    "PublicBaseUrl": "",
    "Local": { "RootPath": "data/storage" }
  },
  "Ai": {
    "Provider": "Auto",
    "ProcessInline": false,
    "MaxConcurrency": 2,
    "OpenAI": {
      "Model": "gpt-4.1-mini",
      "BaseUrl": "https://api.openai.com/v1/",
      "TimeoutSeconds": 90,
      "ImageDetail": "auto"
    }
  },
  "App": { "WebBaseUrl": "http://localhost:3000" },
  "Inspections": {
    "MinimumGeneralPhotosPerRoom": 1,
    "MaxPhotosPerRoom": 40,
    "MaxUploadBytes": 15728640,
    "PrivateInvitationDays": 7,
    "TenantInvitationDays": 14,
    "ReportShareLinkDays": 30,
    "MediaUrlMinutes": 30
  },
  "Billing": {
    "Provider": "Auto",
    "SubscriptionRequiredRoles": [ "Company" ],
    "GraceDays": 7,
    "CheckoutMinutes": 60,
    "Plans": [
      {
        "Code": "professional",
        "Name": "Professional",
        "Description": "Everything a letting agency or property manager needs to run move-in and move-out inspections.",
        "PriceCents": 4900,
        "Currency": "EUR",
        "Interval": "Month",
        "Features": [
          "Unlimited properties with room-by-room layouts",
          "Move In, Move Out and periodic inspections",
          "Public marketplace or private invitations for inspectors",
          "AI-assisted room and defect descriptions",
          "Move In vs Move Out comparison",
          "Immutable PDF reports with share links",
          "Tenant review, observations and sign-off"
        ],
        "StripePriceId": "",
        "Translations": {
          "pt-BR": {
            "Name": "Profissional",
            "Description": "Tudo o que uma imobiliária ou administradora precisa para fazer vistorias de entrada e de saída.",
            "Features": [
              "Imóveis ilimitados com cômodos definidos um a um",
              "Vistorias de entrada, de saída e periódicas",
              "Marketplace público ou convites privados para vistoriadores",
              "Descrições de cômodos e avarias com apoio de IA",
              "Comparação entre entrada e saída",
              "Laudos em PDF imutáveis com links de compartilhamento",
              "Revisão, observações e aceite pelo inquilino"
            ]
          }
        }
      }
    ],
    "Stripe": { "BaseUrl": "https://api.stripe.com/v1/", "WebhookToleranceSeconds": 300 },
    "Sandbox": { "AllowOutsideDevelopment": false }
  },
  "Database": { "MigrateOnStartup": false },
  "Seed": { "Enabled": false }
}
