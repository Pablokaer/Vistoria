{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "inspectflow",
    "Audience": "inspectflow-clients",
    "Secret": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "Provider": "Local",
    "SigningKey": "",
    "PublicBaseUrl": "",
    "Local": { "RootPath": "data/storage" }
  },
  "Ai": {
    "Provider": "Auto",
    "ProcessInline": false,
    "MaxConcurrency": 2,
    "OpenAI": {
      "Model": "gpt-4.1-mini",
      "BaseUrl": "https://api.openai.com/v1/",
      "TimeoutSeconds": 90,
      "ImageDetail": "auto"
    }
  },
  "App": { "WebBaseUrl": "http://localhost:3000" },
  "Inspections": {
    "MinimumGeneralPhotosPerRoom": 1,
    "MaxPhotosPerRoom": 40,
    "MaxUploadBytes": 15728640,
    "PrivateInvitationDays": 7,
    "TenantInvitationDays": 14,
    "ReportShareLinkDays": 30,
    "MediaUrlMinutes": 30
  },
  "Database": { "MigrateOnStartup": false },
  "Seed": { "Enabled": false }
}
