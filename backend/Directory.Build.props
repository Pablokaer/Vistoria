<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1848 (LoggerMessage delegates) and CA2007 (ConfigureAwait) are noise for an ASP.NET Core app. -->
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1711;CA1716;CA1720;CA1724;CA1034;CA1062;CA1303;CA1305;CA1307;CA1308;CA1309;CA1310;CA1311;CA1812;CA1819;CA1822;CA1852;CA1860;CA1861;CA1002;CA2227;CA1056;CA1054;CA1055;CA2234;CA1031;CA5394;CA1515;CA1805;CA1869;CA1806;CA1873;CA1862;CA1859</NoWarn>
  </PropertyGroup>
</Project>
